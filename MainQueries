-- 1. Total Monthly Revenue
SELECT MONTH(Payment_date) AS Month, SUM(Amount_paid) AS Total_Revenue
FROM Payments
GROUP BY MONTH(Payment_date)
ORDER BY Month;

-- 2. Top 5 Customers by Spending
SELECT c.Name, SUM(s.Total_amount) AS Total_Spent
FROM Customer c
JOIN Sales s ON c.Customer_ID = s.Customer_ID
GROUP BY c.Customer_ID
ORDER BY Total_Spent DESC
LIMIT 5;

-- 3. Current Inventory Levels
SELECT p.Product_name, p.Price, i.Quantity
FROM Inventory i
JOIN Product p ON i.Product_ID = p.Product_ID
ORDER BY i.Quantity ASC;

-- 4. Monthly Profit
SELECT 
    MONTH(Payment_date) AS Month,
    SUM(Amount_paid) AS Revenue,
    (SELECT SUM(Amount) FROM Expenses WHERE MONTH(Date) = MONTH(Payment_date)) AS Expenses,
    SUM(Amount_paid) - (SELECT SUM(Amount) FROM Expenses WHERE MONTH(Date) = MONTH(Payment_date)) AS Profit
FROM Payments
GROUP BY MONTH(Payment_date)
ORDER BY Month;

-- 5. Customer Purchase History
SELECT c.Name, s.Sale_ID, s.Sale_date, s.Total_amount, p.Payment_status
FROM Customer c
JOIN Sales s ON c.Customer_ID = s.Customer_ID
JOIN Payments p ON s.Sale_ID = p.Sale_ID
ORDER BY c.Name, s.Sale_date DESC;

-- 6. Most Sold Products
SELECT p.Product_name, SUM(sp.Quantity) AS Total_Sold
FROM Product p
JOIN Sale_Product sp ON p.Product_ID = sp.Product_ID
GROUP BY p.Product_ID
ORDER BY Total_Sold DESC;

-- 7. Outstanding Payments
SELECT c.Name, s.Sale_ID, s.Sale_date, p.Amount_paid, p.Payment_status
FROM Payments p
JOIN Sales s ON p.Sale_ID = s.Sale_ID
JOIN Customer c ON s.Customer_ID = c.Customer_ID
WHERE p.Payment_status = 'Pending'
ORDER BY s.Sale_date ASC;

-- 8. Expenses Breakdown by Category
SELECT Category, SUM(Amount) AS Total, MONTH(Date) AS Month
FROM Expenses
GROUP BY Category, MONTH(Date)
ORDER BY Month, Total DESC;
